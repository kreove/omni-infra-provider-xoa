# Published image tag or a locally built image.
PROVIDER_IMAGE=ghcr.io/kreove/omni-infra-provider-xoa:VERSION

# Values returned by: omnictl infraprovider create xoa
# The service account key is shown only once, at creation. If you lost it,
# run: omnictl infraprovider renewkey xoa
OMNI_ENDPOINT=https://omni.example.com
OMNI_SERVICE_ACCOUNT_KEY=replace-me

# Xen Orchestra endpoint (ws:// or wss://).
XOA_ENDPOINT=wss://xoa.example.com

# Authenticate with EITHER a token (preferred) or username/password.
# A token wins if both are set. Get one with:
#   xo-cli create-token https://xoa.example.com provider-user
XOA_TOKEN=replace-me
# XOA_USERNAME=provider-user
# XOA_PASSWORD=replace-me

# Public or self-hosted Talos Image Factory.
TALOS_IMAGE_FACTORY_BASE_URL=https://factory.talos.dev
